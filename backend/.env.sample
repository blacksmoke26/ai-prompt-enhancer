# Server configuration
# Example: 127.0.0.1 for localhost
HOST=0.0.0.0
# Example: 8080 for alternative port
PORT=3000
# Example: true for debug logging
LOGGING_FASTIFY_SERVER=true

# CORS configuration
# Example: https://example.com
CORS_ALLOWED_ORIGIN=
# Example: 192.168.1.1,10.0.0.1
CORS_ALLOWED_IPS=
# Example: Content-Type,Authorization
CORS_ALLOWED_ORIGIN_HEADERS=

# Rate limiting configuration
# Example: 50 for stricter limits
RATE_LIMIT_MAX=100
# Example: '5 minutes' for longer window
RATE_LIMIT_TIME_WINDOW='1 minute'

# SQLite storage location relative to project root
# Example: ./data/app.db
SQLITE_STORAGE=database/database.sqlite
