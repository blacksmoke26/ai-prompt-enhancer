{
  "name": "ai-prompt-enhancer-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Prompt Enhancement Utility",
  "main": "dist/index.js",
  "author": "Junaid Atari",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug": "tsx watch --inspect-brk src/index.ts",
    "sandbox": "tsx watch src/sandbox.ts",
    "clean": "rimraf coverage dist tmp && mkdir coverage dist",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:seed": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "db:seed:undo": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:seed:undo:all",
    "db:rollback": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:rollback:all": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
    "lint": "eslint",
    "prettier": "prettier --config .prettierrc --write .",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@fastify/accepts": "^5.0.4",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/middie": "^9.0.3",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/websocket": "^11.2.0",
    "@junaidatari/env-binder": "^0.0.1",
    "@scalar/fastify-api-reference": "^1.40.9",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-i18n": "^4.2.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "deepmerge": "^4.3.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-ip": "^2.0.0",
    "fastify-raw-body": "^5.0.0",
    "joi": "^18.0.2",
    "json-schema": "^0.4.0",
    "mime": "^4.1.0",
    "object-path": "^0.11.8",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "sequelize-cli": "^6.6.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "keywords": [
    "ai",
    "prompt",
    "enhancement",
    "ollama",
    "fastify"
  ],
  "license": "MIT"
}
